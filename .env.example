# Variables de "Cargar mercancía con IA" (ver docs/ai/cargar-mercancia.md §6).
# Las demás variables del servidor están en docs/DEPLOY.md §6.

# Clave del proveedor. Sin ella subir un archivo responde 503 ("IA no configurada") y no se crea la carga.
ANTHROPIC_API_KEY=
# Modelo (por omisión claude-opus-5-5).
AI_MODELO=claude-opus-5-5
# Tope de tokens (entrada + salida) por organización y día (por omisión 200000).
AI_TOKENS_DIA_ORG=200000
# Tope en segundos de cada llamada al proveedor (por omisión 300), con un solo reintento.
AI_TIMEOUT_SEG=300
