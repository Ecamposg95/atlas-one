[Unit]
Description=Atlas POS Local Print Agent
Documentation=https://github.com/Ecamposg95/Atlas-API/blob/main/context/contexto_agente_impresion_linux.md
After=network-online.target cups.service
Wants=network-online.target cups.service

[Service]
# Plantilla: instalar-servicio-linux.sh sustituye {WORKDIR}, {ORIGINS} y {PORT},
# y ajusta User/Group. NO editar a mano el archivo instalado en
# /etc/systemd/system — se sobrescribe en la siguiente instalación.
User=%i
Group=%i

WorkingDirectory={WORKDIR}
ExecStart={WORKDIR}/venv/bin/python3 {WORKDIR}/main.py

Environment=ATLAS_AGENT_HOST=127.0.0.1
Environment=ATLAS_AGENT_PORT={PORT}
# Dominios desde los que se sirve el POS. Sin el dominio correcto aquí, una
# caja servida desde un dominio ajeno VENDE PERO NO IMPRIME: el navegador
# manda ese Origin y el agente lo rechaza en el preflight CORS. El regex de
# fábrica del agente ya cubre localhost, *.up.railway.app y
# (*.)atlasone.com.mx — o sea app.atlasone.com.mx entra sin esta variable.
# Se graba de todos modos como refuerzo explícito, y es el ÚNICO camino para
# un dominio propio distinto (p. ej. https://pos.micliente.com).
Environment=ATLAS_AGENT_ORIGINS={ORIGINS}

# Que systemd reinicie si el proceso muere.
Restart=always
RestartSec=5

# Logs al journal, además del agent.log del WorkingDirectory.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=atlas-print-agent

# Hardening razonable — NO lockdown completo porque el agente corre subprocess
# lpadmin/cupsenable/lp que necesitan acceso a sockets CUPS.
NoNewPrivileges=true
ProtectSystem=true

[Install]
WantedBy=multi-user.target
