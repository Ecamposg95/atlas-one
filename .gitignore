# =====================================================================
# Atlas BOS — root .gitignore
# =====================================================================

# ---------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
.Python
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Packaging / build
build/
dist/
wheels/
*.manifest
*.spec
pip-wheel-metadata/

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.cache/

# Coverage
coverage/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# ---------------------------------------------------------------------
# Node / Frontend
# ---------------------------------------------------------------------
node_modules/
frontend/node_modules
frontend/dist/
frontend/build/
.npm/
.pnpm-store/
.yarn/
.yarn-integrity
*.tsbuildinfo

# ---------------------------------------------------------------------
# Build / dist (root)
# ---------------------------------------------------------------------
dist/
build/

# ---------------------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key

# Keep examples
!.env.example
!.env.sample

# ---------------------------------------------------------------------
# Databases / dumps
# ---------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
sql_app.db
.keychain/

# ---------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------
# IDE / Editors
# ---------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ---------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------
*.bak
*.tmp
*.temp
file::memory:

# Worktrees locales de Claude Code
.claude/worktrees/

# Credenciales de cuentas QA — nunca al repositorio ni a la imagen
acceso-qa-atlasone.pdf
# PDFs sueltos en la raíz (suelen ser exportes con datos). Los de docs/ sí van.
/*.pdf

# Volcados de base de datos: pesan mucho y arrastran hashes de contraseña
dumps/
*.sql.gz

# El Dockerfile de raiz NO debe llegar a main: Railway lo prioriza sobre
# Railpack y cambiaria la compilacion de produccion. Vive en el servidor.
/Dockerfile
/.dockerignore

# Subidas en tiempo de ejecución: en el servidor viven en volúmenes Docker,
# así que versionarlas es peso muerto que ademas queda tapado por el volumen.
app/static/uploads/*
!app/static/uploads/.gitkeep
app/static/product_images/*
!app/static/product_images/.gitkeep
app/static/branch_logos/*
!app/static/branch_logos/.gitkeep
